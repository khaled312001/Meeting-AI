DEEPGRAM_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Frontend (Next.js / Electron) — baked in at build time.
# URL of your deployed worker API (realtime-worker-api). Defaults to
# http://localhost:8787 for local development.
NEXT_PUBLIC_BACKEND_API_URL=
# Where the dashboard's "Download desktop app" button points (installer file or
# releases page). Leave empty to show only the browser "Install app" option.
NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=
# Optional analytics. Leave empty to disable.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Pages: /            → live assistant (overlay)
#        /dashboard   → user dashboard (knowledge base, profile, history, support)
#        /admin       → admin panel (users, plans, AI provider + Anthropic key, usage)
# Admin access: put your email in ADMIN_EMAILS in realtime-worker-api/.dev.vars
# (or as a worker secret in production).
# Local test accounts: cd realtime-worker-api && bun run seed:dev
# (accounts + password are listed in realtime-worker-api/scripts/seed-dev-accounts.mjs).
